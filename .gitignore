backend/*.iws
backend/out/

# Eclipse
backend/.classpath
backend/.project
backend/.settings/
backend/bin/

# VS Code
backend/.vscode/

# Spring Boot
backend/target/

# Logs
backend/*.log
backend/logs/

# OS
backend/.DS_Store
backend/Thumbs.db

# ============================================================================
